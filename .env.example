# Puerto local (Render lo asigna solo en producción)
PORT=4000

# PostgreSQL de Supabase
# DATABASE_URL: conexión "Transaction pooler" (puerto 6543) con ?pgbouncer=true
# DIRECT_URL:   conexión "Session pooler" o directa (puerto 5432), la usan las migraciones
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# JWT (obligatorio, sin valor por defecto en el código)
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="2h"

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:3000,https://tu-frontend.vercel.app"

# Supabase Storage (bucket público para las imágenes de productos)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clave-service-role-de-supabase"
SUPABASE_BUCKET="products"